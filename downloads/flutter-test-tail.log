              '            actions: [\n'
              '              TextButton(\n'
              '                onPressed: () => Navigator.pop(dialogContext, false),\n'
              '                child: const Text(\'Отмена\'),\n'
              '              ),\n'
              '              FilledButton(\n'
              '                onPressed: () {\n'
              '                  final amount = parseAmount(amountController.text);\n'
              '                  if (amount <= 0) {\n'
              '                    ScaffoldMessenger.of(dialogContext).showSnackBar(\n'
              '                      const SnackBar(\n'
              '                        content: Text(\'Укажи сумму выплаты больше нуля\'),\n'
              '                      ),\n'
              '                    );\n'
              '                    return;\n'
              '                  }\n'
              '                  Navigator.pop(dialogContext, true);\n'
              '                },\n'
              '                child: const Text(\'Сохранить\'),\n'
              '              ),\n'
              '            ],\n'
              '          );\n'
              '        },\n'
              '      ),\n'
              '    );\n'
              '\n'
              '    if (saved == true) {\n'
              '      await runBusy(() async {\n'
              '        await repository.updatePayment(\n'
              '          id: source.id,\n'
              '          employeeId: source.employeeId,\n'
              '          periodYear: settlementMonth.year,\n'
              '          periodMonth: settlementMonth.month,\n'
              '          paymentDate: paymentDate,\n'
              '          amount: parseAmount(amountController.text),\n'
              '          paymentType: paymentType,\n'
              '          comment: commentController.text,\n'
              '        );\n'
              '        await load();\n'
              '      });\n'
              '      if (mounted && errorText == null) {\n'
              '        ScaffoldMessenger.of(context).showSnackBar(\n'
              '          const SnackBar(content: Text(\'Выплата изменена\')),\n'
              '        );\n'
              '      }\n'
              '    }\n'
              '\n'
              '    amountController.dispose();\n'
              '    commentController.dispose();\n'
              '  }\n'
              '\n'
              '  Future<void> deleteExpense(ExpenseItemData item) async {\n'
              '    if (!item.isEditable || item.isPayment) return;\n'
              '    final confirmed = await showDialog<bool>(\n'
              '      context: context,\n'
              '      builder: (context) => AlertDialog(\n'
              '        title: const Text(\'Удалить расход?\'),\n'
              '        content: Text(\n'
              '          \'«${item.name}» на ${formatMoney(item.amount)} будет удалён вместе с прикреплёнными чеками.\',\n'
              '        ),\n'
              '        actions: [\n'
              '          TextButton(\n'
              '            onPressed: () => Navigator.pop(context, false),\n'
              '            child: const Text(\'Отмена\'),\n'
              '          ),\n'
              '          FilledButton(\n'
              '            onPressed: () => Navigator.pop(context, true),\n'
              '            child: const Text(\'Удалить\'),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '    if (confirmed != true) return;\n'
              '    await runBusy(() async {\n'
              '      await repository.deleteExpense(item.id);\n'
              '      await load();\n'
              '    });\n'
              '  }\n'
              '\n'
              '  Future<void> deletePayment(ExpenseItemData item) async {\n'
              '    if (!item.isPayment || item.id.isEmpty) return;\n'
              '    final confirmed = await showDialog<bool>(\n'
              '      context: context,\n'
              '      builder: (context) => AlertDialog(\n'
              '        title: const Text(\'Удалить выплату?\'),\n'
              '        content: Text(\n'
              '          \'${item.counterpartyName.trim().isEmpty ? \'Выплата\' : item.counterpartyName.trim()} — ${formatMoney(item.amount)} от ${formatDate(item.date)}. Запись удалится и из раздела «Выплаты», а прикреплённые чеки будут удалены.\',\n'
              '        ),\n'
              '        actions: [\n'
              '          TextButton(\n'
              '            onPressed: () => Navigator.pop(context, false),\n'
              '            child: const Text(\'Отмена\'),\n'
              '          ),\n'
              '          FilledButton(\n'
              '            onPressed: () => Navigator.pop(context, true),\n'
              '            child: const Text(\'Удалить\'),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '    if (confirmed != true) return;\n'
              '    await runBusy(() async {\n'
              '      await repository.deletePayment(item.id);\n'
              '      await load();\n'
              '    });\n'
              '    if (mounted && errorText == null) {\n'
              '      ScaffoldMessenger.of(context).showSnackBar(\n'
              '        const SnackBar(content: Text(\'Выплата удалена\')),\n'
              '      );\n'
              '    }\n'
              '  }\n'
              '\n'
              '  Future<void> openReceipt(ExpenseAttachmentData receipt) async {\n'
              '    await runBusy(() async {\n'
              '      final rawUrl = await repository.createReceiptSignedUrl(receipt);\n'
              '      final uri = Uri.tryParse(rawUrl);\n'
              '      if (uri == null || !await launchUrl(uri)) {\n'
              '        throw StateError(\'Не удалось открыть чек\');\n'
              '      }\n'
              '    });\n'
              '  }\n'
              '\n'
              '  Future<void> deleteReceipt(\n'
              '    BuildContext sheetContext,\n'
              '    ExpenseAttachmentData receipt,\n'
              '  ) async {\n'
              '    if (!receipt.isEditable) return;\n'
              '    final confirmed = await showDialog<bool>(\n'
              '      context: context,\n'
              '      builder: (context) => AlertDialog(\n'
              '        title: const Text(\'Удалить чек?\'),\n'
              '        content: Text(\'Файл «${receipt.fileName}» будет удалён.\'),\n'
              '        actions: [\n'
              '          TextButton(\n'
              '            onPressed: () => Navigator.pop(context, false),\n'
              '            child: const Text(\'Отмена\'),\n'
              '          ),\n'
              '          FilledButton(\n'
              '            onPressed: () => Navigator.pop(context, true),\n'
              '            child: const Text(\'Удалить\'),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '    if (confirmed != true) return;\n'
              '    await runBusy(() async {\n'
              '      await repository.deleteReceipt(receipt);\n'
              '      if (sheetContext.mounted) Navigator.pop(sheetContext);\n'
              '      await load();\n'
              '    });\n'
              '  }\n'
              '\n'
              '  Future<void> showReceipts(ExpenseItemData item) async {\n'
              '    if (item.attachments.isEmpty) return;\n'
              '    await showModalBottomSheet<void>(\n'
              '      context: context,\n'
              '      showDragHandle: true,\n'
              '      builder: (sheetContext) => SafeArea(\n'
              '        child: Padding(\n'
              '          padding: const EdgeInsets.fromLTRB(16, 0, 16, 20),\n'
              '          child: Column(\n'
              '            mainAxisSize: MainAxisSize.min,\n'
              '            crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '            children: [\n'
              '              Text(\n'
              '                item.isPayment ? \'Чеки выплаты\' : \'Чеки расхода\',\n'
              '                style: const TextStyle(fontSize: 19, fontWeight: FontWeight.w900),\n'
              '              ),\n'
              '              const SizedBox(height: 10),\n'
              '              ...item.attachments.map(\n'
              '                (receipt) => ListTile(\n'
              '                  contentPadding: EdgeInsets.zero,\n'
              '                  leading: Icon(\n'
              '                    receipt.contentType == \'application/pdf\'\n'
              '                        ? Icons.picture_as_pdf_outlined\n'
              '                        : Icons.image_outlined,\n'
              '                  ),\n'
              '                  title: Text(\n'
              '                    receipt.fileName.isEmpty ? \'Чек\' : receipt.fileName,\n'
              '                    maxLines: 1,\n'
              '                    overflow: TextOverflow.ellipsis,\n'
              '                  ),\n'
              '                  subtitle: const Text(\'Нажми, чтобы открыть\'),\n'
              '                  onTap: busy ? null : () => openReceipt(receipt),\n'
              '                  trailing: receipt.isEditable\n'
              '                      ? IconButton(\n'
              '                          tooltip: \'Удалить чек\',\n'
              '                          onPressed: busy\n'
              '                              ? null\n'
              '                              : () => deleteReceipt(sheetContext, receipt),\n'
              '                          icon: const Icon(Icons.delete_outline_rounded),\n'
              '                        )\n'
              '                      : null,\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Future<void> handleAction(ExpenseItemData item, String value) async {\n'
              '    if (value == \'edit\') {\n'
              '      if (item.isPayment) {\n'
              '        await editPayment(item);\n'
              '      } else {\n'
              '        await editExpense(item);\n'
              '      }\n'
              '      return;\n'
              '    }\n'
              '    if (value == \'delete\') {\n'
              '      if (item.isPayment) {\n'
              '        await deletePayment(item);\n'
              '      } else {\n'
              '        await deleteExpense(item);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  Widget actionMenu(ExpenseItemData item) {\n'
              '    final hasActions = item.isPayment || item.isEditable;\n'
              '    return SizedBox(\n'
              '      width: 40,\n'
              '      child: hasActions\n'
              '          ? PopupMenuButton<String>(\n'
              '              enabled: !busy,\n'
              '              tooltip: \'Действия\',\n'
              '              onSelected: (value) => handleAction(item, value),\n'
              '              itemBuilder: (_) => const [\n'
              '                PopupMenuItem(\n'
              '                  value: \'edit\',\n'
              '                  child: Row(\n'
              '                    children: [\n'
              '                      Icon(Icons.edit_outlined, size: 19),\n'
              '                      SizedBox(width: 10),\n'
              '                      Text(\'Изменить\'),\n'
              '                    ],\n'
              '                  ),\n'
              '                ),\n'
              '                PopupMenuItem(\n'
              '                  value: \'delete\',\n'
              '                  child: Row(\n'
              '                    children: [\n'
              '                      Icon(Icons.delete_outline_rounded, size: 19),\n'
              '                      SizedBox(width: 10),\n'
              '                      Text(\'Удалить\'),\n'
              '                    ],\n'
              '                  ),\n'
              '                ),\n'
              '              ],\n'
              '            )\n'
              '          : null,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget receiptStatus(ExpenseItemData item) {\n'
              '    if (item.attachments.isNotEmpty) {\n'
              '      final label = item.attachments.length == 1\n'
              '          ? \'Чек\'\n'
              '          : \'Чеки: ${item.attachments.length}\';\n'
              '      return SizedBox(\n'
              '        height: 32,\n'
              '        child: OutlinedButton.icon(\n'
              '          onPressed: busy ? null : () => showReceipts(item),\n'
              '          style: OutlinedButton.styleFrom(\n'
              '            padding: const EdgeInsets.symmetric(horizontal: 9),\n'
              '            minimumSize: Size.zero,\n'
              '            tapTargetSize: MaterialTapTargetSize.shrinkWrap,\n'
              '          ),\n'
              '          icon: const Icon(Icons.attachment_rounded, size: 16),\n'
              '          label: Text(label, maxLines: 1, overflow: TextOverflow.ellipsis),\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '\n'
              '    return Container(\n'
              '      height: 32,\n'
              '      padding: const EdgeInsets.symmetric(horizontal: 9),\n'
              '      decoration: BoxDecoration(\n'
              '        color: Theme.of(context).colorScheme.surfaceContainerHighest,\n'
              '        borderRadius: BorderRadius.circular(10),\n'
              '      ),\n'
              '      child: const Row(\n'
              '        mainAxisSize: MainAxisSize.min,\n'
              '        children: [\n'
              '          Icon(Icons.warning_amber_rounded, size: 16),\n'
              '          SizedBox(width: 5),\n'
              '          Flexible(\n'
              '            child: Text(\n'
              '              \'Без чека\',\n'
              '              maxLines: 1,\n'
              '              overflow: TextOverflow.ellipsis,\n'
              '              style: TextStyle(fontSize: 12, fontWeight: FontWeight.w700),\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget filterPanel() {\n'
              '    final rows = filteredRows;\n'
              '    final total = rows.fold<double>(0, (sum, item) => sum + item.amount);\n'
              '    final payments = rows\n'
              '        .where((item) => item.isPayment)\n'
              '        .fold<double>(0, (sum, item) => sum + item.amount);\n'
              '    final manual = total - payments;\n'
              '    final withoutReceipt = rows.where((item) => item.attachments.isEmpty).length;\n'
              '\n'
              '    return Column(\n'
              '      crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '      children: [\n'
              '        PremiumWorkCard(\n'
              '          radius: 24,\n'
              '          padding: const EdgeInsets.all(18),\n'
              '          child: Column(\n'
              '            crossAxisAlignment: CrossAxisAlignment.start,\n'
              '            children: [\n'
              '              Text(\n'
              '                formatMoney(total),\n'
              '                style: const TextStyle(\n'
              '                  fontSize: 30,\n'
              '                  fontWeight: FontWeight.w900,\n'
              '                ),\n'
              '              ),\n'
              '              const SizedBox(height: 4),\n'
              '              Text(\n'
              '                \'Всего за ${formatDate(from)} — ${formatDate(to)}\',\n'
              '                style: TextStyle(\n'
              '                  color: Theme.of(context).colorScheme.onSurfaceVariant,\n'
              '                ),\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              Wrap(\n'
              '                spacing: 18,\n'
              '                runSpacing: 8,\n'
              '                children: [\n'
              '                  Text(\'Выплаты: ${formatMoney(payments)}\'),\n'
              '                  Text(\'Другие расходы: ${formatMoney(manual)}\'),\n'
              '                  Text(\'Операций: ${rows.length}\'),\n'
              '                  Text(\'Без чека: $withoutReceipt\'),\n'
              '                ],\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '        const SizedBox(height: 12),\n'
              '        PremiumWorkCard(\n'
              '          radius: 24,\n'
              '          padding: const EdgeInsets.all(16),\n'
              '          child: Column(\n'
              '            crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '            children: [\n'
              '              Wrap(\n'
              '                spacing: 12,\n'
              '                runSpacing: 12,\n'
              '                crossAxisAlignment: WrapCrossAlignment.center,\n'
              '                children: [\n'
              '                  SizedBox(\n'
              '                    width: 260,\n'
              '                    child: DropdownButtonFormField<String>(\n'
              '                      key: ValueKey(\n'
              '                        \'expense-category-$selectedCategory-${snapshot.categories.length}\',\n'
              '                      ),\n'
              '                      initialValue: selectedCategory,\n'
              '                      decoration: const InputDecoration(\n'
              '                        labelText: \'Статья расходов\',\n'
              '                        isDense: true,\n'
              '                      ),\n'
              '                      items: [\n'
              '                        const DropdownMenuItem(\n'
              '                          value: _allCategories,\n'
              '                          child: Text(\'Все статьи\'),\n'
              '                        ),\n'
              '                        const DropdownMenuItem(\n'
              '                          value: _paymentsCategory,\n'
              '                          child: Text(\'Выплаты сотрудникам\'),\n'
              '                        ),\n'
              '                        const DropdownMenuItem(\n'
              '                          value: _uncategorized,\n'
              '                          child: Text(\'Без статьи\'),\n'
              '                        ),\n'
              '                        ...snapshot.categories.map(\n'
              '                          (item) => DropdownMenuItem(\n'
              '                            value: item.id,\n'
              '                            child: Text(item.name),\n'
              '                          ),\n'
              '                        ),\n'
              '                      ],\n'
              '                      onChanged: (value) {\n'
              '                        if (value != null) {\n'
              '                          setState(() => selectedCategory = value);\n'
              '                        }\n'
              '                      },\n'
              '                    ),\n'
              '                  ),\n'
              '                  SizedBox(\n'
              '                    width: 260,\n'
              '                    child: DropdownButtonFormField<String>(\n'
              '                      key: ValueKey(\n'
              '                        \'expense-object-$selectedObject-${snapshot.objects.length}\',\n'
              '                      ),\n'
              '                      initialValue: selectedObject,\n'
              '                      decoration: const InputDecoration(\n'
              '                        labelText: \'Объект\',\n'
              '                        isDense: true,\n'
              '                      ),\n'
              '                      items: [\n'
              '                        const DropdownMenuItem(\n'
              '                          value: _allObjects,\n'
              '                          child: Text(\'Все объекты\'),\n'
              '                        ),\n'
              '                        ...snapshot.objects.map(\n'
              '                          (item) => DropdownMenuItem(\n'
              '                            value: item.id,\n'
              '                            child: Text(\n'
              '                              item.isActive ? item.name : \'${item.name} · архив\',\n'
              '                            ),\n'
              '                          ),\n'
              '                        ),\n'
              '                      ],\n'
              '                      onChanged: (value) {\n'
              '                        if (value != null) setState(() => selectedObject = value);\n'
              '                      },\n'
              '                    ),\n'
              '                  ),\n'
              '                  OutlinedButton.icon(\n'
              '                    onPressed: choosePeriod,\n'
              '                    icon: const Icon(Icons.date_range_outlined),\n'
              '                    label: Text(\'${formatDate(from)} — ${formatDate(to)}\'),\n'
              '                  ),\n'
              '                  FilledButton.icon(\n'
              '                    onPressed: busy ? null : () => editExpense(),\n'
              '                    icon: const Icon(Icons.add_rounded),\n'
              '                    label: const Text(\'Добавить расход\'),\n'
              '                  ),\n'
              '                ],\n'
              '              ),\n'
              '              const SizedBox(height: 10),\n'
              '              Text(\n'
              '                snapshot.categories.isEmpty\n'
              '                    ? \'Статьи расходов настраиваются в панели Разработчика.\'\n'
              '                    : \'Выплаты синхронизированы с разделом «Выплаты»: изменение или удаление здесь меняет исходную запись.\',\n'
              '                style: TextStyle(\n'
              '                  color: Theme.of(context).colorScheme.onSurfaceVariant,\n'
              '                  fontSize: 12,\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '        if (errorText != null) ...[\n'
              '          const SizedBox(height: 12),\n'
              '          PremiumWorkCard(\n'
              '            radius: 22,\n'
              '            padding: const EdgeInsets.all(14),\n'
              '            child: Text(\n'
              '              errorText!,\n'
              '              style: TextStyle(color: Theme.of(context).colorScheme.error),\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '        const SizedBox(height: 16),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget expenseListHeader() {\n'
              '    return LayoutBuilder(\n'
              '      builder: (context, constraints) {\n'
              '        if (constraints.maxWidth < _desktopListWidth) {\n'
              '          return const SizedBox.shrink();\n'
              '        }\n'
              '        final style = TextStyle(\n'
              '          color: Theme.of(context).colorScheme.onSurfaceVariant,\n'
              '          fontSize: 11,\n'
              '          fontWeight: FontWeight.w800,\n'
              '          letterSpacing: 0.25,\n'
              '        );\n'
              '        return Padding(\n'
              '          padding: const EdgeInsets.fromLTRB(16, 0, 16, 8),\n'
              '          child: Row(\n'
              '            children: [\n'
              '              const SizedBox(width: 42),\n'
              '              const SizedBox(width: 12),\n'
              '              SizedBox(width: 86, child: Text(\'ДАТА\', style: style)),\n'
              '              const SizedBox(width: 16),\n'
              '              Expanded(flex: 4, child: Text(\'РАСХОД\', style: style)),\n'
              '              const SizedBox(width: 16),\n'
              '              SizedBox(\n'
              '                width: 190,\n'
              '                child: Text(\'СТАТЬЯ / ОБЪЕКТ\', style: style),\n'
              '              ),\n'
              '              const SizedBox(width: 16),\n'
              '              SizedBox(\n'
              '                width: 190,\n'
              '                child: Text(\'СОТРУДНИК / КОНТРАГЕНТ\', style: style),\n'
              '              ),\n'
              '              const SizedBox(width: 16),\n'
              '              SizedBox(width: 112, child: Text(\'ДОКУМЕНТ\', style: style)),\n'
              '              const SizedBox(width: 16),\n'
              '              SizedBox(\n'
              '                width: 120,\n'
              '                child: Text(\'СУММА\', textAlign: TextAlign.right, style: style),\n'
              '              ),\n'
              '              const SizedBox(width: 40),\n'
              '            ],\n'
              '          ),\n'
              '        );\n'
              '      },\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget desktopExpenseCard(ExpenseItemData item) {\n'
              '    final comment = item.comment.trim();\n'
              '    final objectName = (item.objectName ?? \'\').trim();\n'
              '    final responsible = item.counterpartyName.trim();\n'
              '    return PremiumWorkCard(\n'
              '      radius: 18,\n'
              '      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),\n'
              '      child: Row(\n'
              '        crossAxisAlignment: CrossAxisAlignment.center,\n'
              '        children: [\n'
              '          Container(\n'
              '            width: 42,\n'
              '            height: 42,\n'
              '            decoration: BoxDecoration(\n'
              '              color: Theme.of(context).colorScheme.surfaceContainerHighest,\n'
              '              borderRadius: BorderRadius.circular(13),\n'
              '            ),\n'
              '            child: Icon(\n'
              '              item.isPayment\n'
              '                  ? Icons.payments_outlined\n'
              '                  : Icons.receipt_long_outlined,\n'
              '              size: 21,\n'
              '            ),\n'
              '          ),\n'
              '          const SizedBox(width: 12),\n'
              '          SizedBox(\n'
              '            width: 86,\n'
              '            child: Text(\n'
              '              formatDate(item.date),\n'
              '              style: TextStyle(\n'
              '                color: Theme.of(context).colorScheme.onSurfaceVariant,\n'
              '                fontSize: 12,\n'
              '                fontWeight: FontWeight.w700,\n'
              '              ),\n'
              '            ),\n'
              '          ),\n'
              '          const SizedBox(width: 16),\n'
              '          Expanded(\n'
              '            flex: 4,\n'
              '            child: Column(\n'
              '              crossAxisAlignment: CrossAxisAlignment.start,\n'
              '              mainAxisSize: MainAxisSize.min,\n'
              '              children: [\n'
              '                Tooltip(\n'
              '                  message: desktopTitle(item),\n'
              '                  child: Text(\n'
              '                    desktopTitle(item),\n'
              '                    maxLines: 1,\n'
              '                    overflow: TextOverflow.ellipsis,\n'
              '                    style: const TextStyle(\n'
              '                      fontSize: 15,\n'
              '                      fontWeight: FontWeight.w800,\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(height: 4),\n'
              '                SizedBox(\n'
              '                  height: 18,\n'
              '                  child: comment.isEmpty\n'
              '                      ? const SizedBox.shrink()\n'
              '                      : Tooltip(\n'
              '                          message: comment,\n'
              '                          child: Text(\n'
              '                            comment,\n'
              '                            maxLines: 1,\n'
              '                            overflow: TextOverflow.ellipsis,\n'
              '                            style: TextStyle(\n'
