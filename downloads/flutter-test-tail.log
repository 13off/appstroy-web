              '              child: _UnreadBadge(count: unread.unreadCount),\n'
              '            ),\n'
              '          IconButton(\n'
              '            visualDensity: VisualDensity.compact,\n'
              '            tooltip: \'Свернуть\',\n'
              '            onPressed: onCollapse,\n'
              '            icon: const Icon(Icons.remove_rounded, size: 22),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _body(BuildContext context) {\n'
              '    final scheme = Theme.of(context).colorScheme;\n'
              '    if (loading && messages.isEmpty) {\n'
              '      return const Center(\n'
              '        child: SizedBox.square(\n'
              '          dimension: 26,\n'
              '          child: CircularProgressIndicator(strokeWidth: 2.5),\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    if (errorText != null && messages.isEmpty) {\n'
              '      return Center(\n'
              '        child: Padding(\n'
              '          padding: const EdgeInsets.all(22),\n'
              '          child: Column(\n'
              '            mainAxisSize: MainAxisSize.min,\n'
              '            children: [\n'
              '              Icon(\n'
              '                Icons.chat_bubble_outline_rounded,\n'
              '                size: 38,\n'
              '                color: scheme.onSurfaceVariant,\n'
              '              ),\n'
              '              const SizedBox(height: 10),\n'
              '              const Text(\n'
              '                \'Чаты пока не загрузились\',\n'
              '                textAlign: TextAlign.center,\n'
              '                style: TextStyle(fontWeight: FontWeight.w900),\n'
              '              ),\n'
              '              const SizedBox(height: 5),\n'
              '              Text(\n'
              '                errorText!,\n'
              '                maxLines: 4,\n'
              '                overflow: TextOverflow.ellipsis,\n'
              '                textAlign: TextAlign.center,\n'
              '                style: TextStyle(\n'
              '                  color: scheme.onSurfaceVariant,\n'
              '                  fontSize: 11.5,\n'
              '                  height: 1.35,\n'
              '                ),\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              FilledButton.tonalIcon(\n'
              '                onPressed: onRetry,\n'
              '                icon: const Icon(Icons.refresh_rounded, size: 17),\n'
              '                label: const Text(\'Повторить\'),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    if (selectedThread == null) {\n'
              '      return const Center(child: Text(\'Выберите диалог слева\'));\n'
              '    }\n'
              '    if (messages.isEmpty) {\n'
              '      final assistant = selectedThread!.isAssistant;\n'
              '      return Center(\n'
              '        child: Padding(\n'
              '          padding: const EdgeInsets.all(22),\n'
              '          child: Column(\n'
              '            mainAxisSize: MainAxisSize.min,\n'
              '            children: [\n'
              '              Container(\n'
              '                width: 58,\n'
              '                height: 58,\n'
              '                decoration: BoxDecoration(\n'
              '                  color: assistant\n'
              '                      ? scheme.tertiaryContainer\n'
              '                      : scheme.primaryContainer,\n'
              '                  borderRadius: BorderRadius.circular(18),\n'
              '                ),\n'
              '                child: Icon(\n'
              '                  assistant\n'
              '                      ? Icons.auto_awesome_rounded\n'
              '                      : Icons.chat_bubble_outline_rounded,\n'
              '                  color: assistant\n'
              '                      ? scheme.onTertiaryContainer\n'
              '                      : scheme.onPrimaryContainer,\n'
              '                  size: 28,\n'
              '                ),\n'
              '              ),\n'
              '              const SizedBox(height: 13),\n'
              '              Text(\n'
              '                assistant ? \'Напиши ChatGPT\' : \'Сообщений пока нет\',\n'
              '                textAlign: TextAlign.center,\n'
              '                style: const TextStyle(\n'
              '                  fontSize: 16,\n'
              '                  fontWeight: FontWeight.w900,\n'
              '                ),\n'
              '              ),\n'
              '              const SizedBox(height: 5),\n'
              '              Text(\n'
              '                assistant\n'
              '                    ? \'Обычный ChatGPT, подключённый к данным и действиям AppСтрой.\'\n'
              '                    : \'Напишите первое сообщение или прикрепите фото и файл.\',\n'
              '                textAlign: TextAlign.center,\n'
              '                style: TextStyle(\n'
              '                  color: scheme.onSurfaceVariant,\n'
              '                  fontSize: 11.5,\n'
              '                  height: 1.35,\n'
              '                  fontWeight: FontWeight.w600,\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '\n'
              '    return ColoredBox(\n'
              '      color: scheme.surfaceContainerLowest.withValues(alpha: 0.5),\n'
              '      child: ListView.builder(\n'
              '        controller: scrollController,\n'
              '        padding: const EdgeInsets.fromLTRB(12, 12, 12, 8),\n'
              '        itemCount: messages.length,\n'
              '        itemBuilder: (context, index) =>\n'
              '            _messageBubble(context, messages[index]),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _messageBubble(BuildContext context, CompanyChatMessage message) {\n'
              '    final scheme = Theme.of(context).colorScheme;\n'
              '    final own = message.senderUserId == currentUserId;\n'
              '    final assistant = message.isAssistant;\n'
              '    final alignment = own ? Alignment.centerRight : Alignment.centerLeft;\n'
              '    final color = assistant\n'
              '        ? scheme.tertiaryContainer\n'
              '        : own\n'
              '        ? scheme.primaryContainer\n'
              '        : scheme.surfaceContainerHighest;\n'
              '    final body = message.isDeleted ? \'Сообщение удалено\' : message.body.trim();\n'
              '\n'
              '    return Align(\n'
              '      alignment: alignment,\n'
              '      child: Container(\n'
              '        constraints: const BoxConstraints(maxWidth: 430),\n'
              '        margin: const EdgeInsets.only(bottom: 8),\n'
              '        padding: const EdgeInsets.fromLTRB(11, 9, 11, 7),\n'
              '        decoration: BoxDecoration(\n'
              '          color: color,\n'
              '          borderRadius: BorderRadius.circular(15),\n'
              '          border: Border.all(color: scheme.outlineVariant),\n'
              '        ),\n'
              '        child: Column(\n'
              '          crossAxisAlignment: CrossAxisAlignment.start,\n'
              '          children: [\n'
              '            if (!own || selectedThread?.isGeneral == true || assistant) ...[\n'
              '              Row(\n'
              '                mainAxisSize: MainAxisSize.min,\n'
              '                children: [\n'
              '                  Icon(\n'
              '                    assistant\n'
              '                        ? Icons.auto_awesome_rounded\n'
              '                        : Icons.person_rounded,\n'
              '                    size: 12,\n'
              '                    color: assistant\n'
              '                        ? scheme.tertiary\n'
              '                        : scheme.onSurfaceVariant,\n'
              '                  ),\n'
              '                  const SizedBox(width: 5),\n'
              '                  Flexible(\n'
              '                    child: Text(\n'
              '                      assistant ? \'ChatGPT\' : message.senderName,\n'
              '                      maxLines: 1,\n'
              '                      overflow: TextOverflow.ellipsis,\n'
              '                      style: const TextStyle(\n'
              '                        fontSize: 10.5,\n'
              '                        fontWeight: FontWeight.w900,\n'
              '                      ),\n'
              '                    ),\n'
              '                  ),\n'
              '                ],\n'
              '              ),\n'
              '              const SizedBox(height: 4),\n'
              '            ],\n'
              '            if (body.isNotEmpty)\n'
              '              SelectableText(\n'
              '                body,\n'
              '                style: TextStyle(\n'
              '                  color: message.isDeleted\n'
              '                      ? scheme.onSurfaceVariant\n'
              '                      : scheme.onSurface,\n'
              '                  fontSize: 12.5,\n'
              '                  height: 1.35,\n'
              '                  fontStyle: message.isDeleted\n'
              '                      ? FontStyle.italic\n'
              '                      : FontStyle.normal,\n'
              '                  fontWeight: FontWeight.w600,\n'
              '                ),\n'
              '              ),\n'
              '            if (message.attachments.isNotEmpty) ...[\n'
              '              if (body.isNotEmpty) const SizedBox(height: 7),\n'
              '              ...message.attachments.map(\n'
              '                (attachment) => Padding(\n'
              '                  padding: const EdgeInsets.only(bottom: 5),\n'
              '                  child: Material(\n'
              '                    color: scheme.surface.withValues(alpha: 0.58),\n'
              '                    borderRadius: BorderRadius.circular(10),\n'
              '                    child: InkWell(\n'
              '                      borderRadius: BorderRadius.circular(10),\n'
              '                      onTap: () => onOpenAttachment(attachment),\n'
              '                      child: Padding(\n'
              '                        padding: const EdgeInsets.symmetric(\n'
              '                          horizontal: 9,\n'
              '                          vertical: 7,\n'
              '                        ),\n'
              '                        child: Row(\n'
              '                          mainAxisSize: MainAxisSize.min,\n'
              '                          children: [\n'
              '                            Icon(\n'
              '                              attachment.isImage\n'
              '                                  ? Icons.image_outlined\n'
              '                                  : Icons.attach_file_rounded,\n'
              '                              size: 17,\n'
              '                            ),\n'
              '                            const SizedBox(width: 7),\n'
              '                            Flexible(\n'
              '                              child: Text(\n'
              '                                attachment.fileName,\n'
              '                                maxLines: 1,\n'
              '                                overflow: TextOverflow.ellipsis,\n'
              '                                style: const TextStyle(\n'
              '                                  fontSize: 11,\n'
              '                                  fontWeight: FontWeight.w800,\n'
              '                                ),\n'
              '                              ),\n'
              '                            ),\n'
              '                            const SizedBox(width: 7),\n'
              '                            Text(\n'
              '                              _fileSize(attachment.sizeBytes),\n'
              '                              style: TextStyle(\n'
              '                                color: scheme.onSurfaceVariant,\n'
              '                                fontSize: 9.5,\n'
              '                                fontWeight: FontWeight.w700,\n'
              '                              ),\n'
              '                            ),\n'
              '                          ],\n'
              '                        ),\n'
              '                      ),\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '            if (assistant && message.hasAiAction && !message.isDeleted) ...[\n'
              '              const SizedBox(height: 8),\n'
              '              _AiActionButton(\n'
              '                message: message,\n'
              '                runningActionIds: runningActionIds,\n'
              '                onPressed: () => onRunAiAction(message),\n'
              '              ),\n'
              '            ],\n'
              '            const SizedBox(height: 4),\n'
              '            Align(\n'
              '              alignment: Alignment.centerRight,\n'
              '              child: Text(\n'
              '                _time(message.createdAt),\n'
              '                style: TextStyle(\n'
              '                  color: scheme.onSurfaceVariant,\n'
              '                  fontSize: 9.5,\n'
              '                  fontWeight: FontWeight.w700,\n'
              '                ),\n'
              '              ),\n'
              '            ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _composer(BuildContext context) {\n'
              '    final scheme = Theme.of(context).colorScheme;\n'
              '    final assistant = selectedThread?.isAssistant == true;\n'
              '    final locked = assistant && _aiAssistantLocked;\n'
              '    return Container(\n'
              '      decoration: BoxDecoration(\n'
              '        color: scheme.surface,\n'
              '        border: Border(top: BorderSide(color: scheme.outlineVariant)),\n'
              '      ),\n'
              '      child: Column(\n'
              '        crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '        children: [\n'
              '          if (pendingFiles.isNotEmpty)\n'
              '            SizedBox(\n'
              '              height: 47,\n'
              '              child: ListView.separated(\n'
              '                scrollDirection: Axis.horizontal,\n'
              '                padding: const EdgeInsets.fromLTRB(10, 7, 10, 4),\n'
              '                itemCount: pendingFiles.length,\n'
              '                separatorBuilder: (_, _) => const SizedBox(width: 6),\n'
              '                itemBuilder: (context, index) {\n'
              '                  final item = pendingFiles[index];\n'
              '                  return InputChip(\n'
              '                    avatar: Icon(\n'
              '                      _isImageName(item.file.name)\n'
              '                          ? Icons.image_outlined\n'
              '                          : Icons.attach_file_rounded,\n'
              '                      size: 16,\n'
              '                    ),\n'
              '                    label: ConstrainedBox(\n'
              '                      constraints: const BoxConstraints(maxWidth: 150),\n'
              '                      child: Text(\n'
              '                        item.file.name,\n'
              '                        maxLines: 1,\n'
              '                        overflow: TextOverflow.ellipsis,\n'
              '                      ),\n'
              '                    ),\n'
              '                    onDeleted: sending ? null : () => onRemovePending(item),\n'
              '                  );\n'
              '                },\n'
              '              ),\n'
              '            ),\n'
              '          Padding(\n'
              '            padding: const EdgeInsets.fromLTRB(8, 7, 8, 9),\n'
              '            child: Row(\n'
              '              crossAxisAlignment: CrossAxisAlignment.end,\n'
              '              children: [\n'
              '                IconButton(\n'
              '                  tooltip: \'Прикрепить фото или файл\',\n'
              '                  onPressed: locked || sending || selectedThread == null\n'
              '                      ? null\n'
              '                      : onPickFiles,\n'
              '                  icon: const Icon(Icons.attach_file_rounded),\n'
              '                ),\n'
              '                Expanded(\n'
              '                  child: TextField(\n'
              '                    controller: messageController,\n'
              '                    enabled: !locked && !sending && selectedThread != null,\n'
              '                    minLines: 1,\n'
              '                    maxLines: 4,\n'
              '                    textCapitalization: TextCapitalization.sentences,\n'
              '                    textInputAction: TextInputAction.send,\n'
              '                    onSubmitted: (_) => onSend(),\n'
              '                    decoration: InputDecoration(\n'
              '                      hintText: locked\n'
              '                          ? \'ChatGPT временно недоступен\'\n'
              '                          : assistant\n'
              '                          ? \'Сообщение ChatGPT…\'\n'
              '                          : \'Сообщение…\',\n'
              '                      isDense: true,\n'
              '                      filled: true,\n'
              '                      fillColor: scheme.surfaceContainerHighest.withValues(\n'
              '                        alpha: 0.62,\n'
              '                      ),\n'
              '                      border: OutlineInputBorder(\n'
              '                        borderRadius: BorderRadius.circular(16),\n'
              '                        borderSide: BorderSide.none,\n'
              '                      ),\n'
              '                      contentPadding: const EdgeInsets.symmetric(\n'
              '                        horizontal: 12,\n'
              '                        vertical: 10,\n'
              '                      ),\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(width: 6),\n'
              '                IconButton.filled(\n'
              '                  tooltip: locked\n'
              '                      ? \'ChatGPT временно недоступен\'\n'
              '                      : assistant\n'
              '                      ? \'Отправить ChatGPT\'\n'
              '                      : \'Отправить\',\n'
              '                  onPressed:\n'
              '                      locked || sending || askingAi || selectedThread == null\n'
              '                      ? null\n'
              '                      : onSend,\n'
              '                  icon: locked\n'
              '                      ? const Icon(Icons.lock_rounded, size: 19)\n'
              '                      : sending || askingAi\n'
              '                      ? const SizedBox.square(\n'
              '                          dimension: 17,\n'
              '                          child: CircularProgressIndicator(strokeWidth: 2),\n'
              '                        )\n'
              '                      : Icon(\n'
              '                          assistant\n'
              '                              ? Icons.auto_awesome_rounded\n'
              '                              : Icons.send_rounded,\n'
              '                          size: 19,\n'
              '                        ),\n'
              '                ),\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static String _time(DateTime value) {\n'
              '    final local = value.toLocal();\n'
              '    return \'${local.hour.toString().padLeft(2, \'0\')}:${local.minute.toString().padLeft(2, \'0\')}\';\n'
              '  }\n'
              '\n'
              '  static String _fileSize(int bytes) {\n'
              '    if (bytes < 1024) return \'$bytes Б\';\n'
              '    if (bytes < 1024 * 1024) return \'${(bytes / 1024).toStringAsFixed(1)} КБ\';\n'
              '    return \'${(bytes / (1024 * 1024)).toStringAsFixed(1)} МБ\';\n'
              '  }\n'
              '}\n'
              '\n'
              'class _AiActionButton extends StatelessWidget {\n'
              '  final CompanyChatMessage message;\n'
              '  final Set<String> runningActionIds;\n'
              '  final VoidCallback onPressed;\n'
              '\n'
              '  const _AiActionButton({\n'
              '    required this.message,\n'
              '    required this.runningActionIds,\n'
              '    required this.onPressed,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final rawAction = message.aiPayload[\'action\'];\n'
              '    if (rawAction is! Map) return const SizedBox.shrink();\n'
              '    final action = AiAssistantAction.fromMap(\n'
              '      Map<String, dynamic>.from(rawAction),\n'
              '    );\n'
              '    if (action.id.isEmpty) return const SizedBox.shrink();\n'
              '    final running = runningActionIds.contains(action.id);\n'
              '    return SizedBox(\n'
              '      width: double.infinity,\n'
              '      child: FilledButton.tonalIcon(\n'
              '        onPressed: running ? null : onPressed,\n'
              '        icon: running\n'
              '            ? const SizedBox.square(\n'
              '                dimension: 16,\n'
              '                child: CircularProgressIndicator(strokeWidth: 2),\n'
              '              )\n'
              '            : const Icon(Icons.fact_check_outlined, size: 18),\n'
              '        label: Text(action.buttonLabel),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ThreadSidebar extends StatelessWidget {\n'
              '  final List<CompanyChatThread> threads;\n'
              '  final CompanyChatThread? selectedThread;\n'
              '  final ValueChanged<CompanyChatThread> onSelectThread;\n'
              '\n'
              '  const _ThreadSidebar({\n'
              '    required this.threads,\n'
              '    required this.selectedThread,\n'
              '    required this.onSelectThread,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final scheme = Theme.of(context).colorScheme;\n'
              '    final general = threads.where((item) => item.isGeneral).toList();\n'
              '    final direct = threads.where((item) => item.isDirect).toList();\n'
              '    final assistant = threads.where((item) => item.isAssistant).toList();\n'
              '    return LayoutBuilder(\n'
              '      builder: (context, constraints) {\n'
              '        final width = math.min(\n'
              '          230.0,\n'
              '          math.max(150.0, constraints.maxWidth * 0.31),\n'
              '        );\n'
              '        return SizedBox(\n'
              '          width: width,\n'
              '          child: ColoredBox(\n'
              '            color: scheme.surfaceContainerLowest.withValues(alpha: 0.72),\n'
              '            child: Column(\n'
              '              crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '              children: [\n'
              '                const Padding(\n'
              '                  padding: EdgeInsets.fromLTRB(16, 15, 12, 8),\n'
              '                  child: Text(\n'
              '                    \'Чаты\',\n'
              '                    style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900),\n'
              '                  ),\n'
              '                ),\n'
              '                if (general.isNotEmpty)\n'
              '                  _ThreadTile(\n'
              '                    thread: general.first,\n'
              '                    selected:\n'
              '                        selectedThread?.threadKey == general.first.threadKey,\n'
              '                    onTap: () => onSelectThread(general.first),\n'
              '                  ),\n'
              '                Padding(\n'
              '                  padding: const EdgeInsets.fromLTRB(14, 12, 14, 6),\n'
              '                  child: Text(\n'
              '                    \'СОТРУДНИКИ\',\n'
              '                    style: TextStyle(\n'
              '                      color: scheme.onSurfaceVariant,\n'
              '                      fontSize: 9.5,\n'
              '                      fontWeight: FontWeight.w900,\n'
              '                      letterSpacing: 0.8,\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '                Expanded(\n'
              '                  child: direct.isEmpty\n'
              '                      ? Center(\n'
              '                          child: Padding(\n'
              '                            padding: const EdgeInsets.all(16),\n'
              '                            child: Text(\n'
              '                              \'Нет других пользователей компании\',\n'
              '                              textAlign: TextAlign.center,\n'
              '                              style: TextStyle(\n'
              '                                color: scheme.onSurfaceVariant,\n'
              '                                fontSize: 11,\n'
              '                                height: 1.35,\n'
              '                              ),\n'
              '                            ),\n'
              '                          ),\n'
              '                        )\n'
              '                      : ListView.builder(\n'
              '                          padding: const EdgeInsets.only(bottom: 8),\n'
              '                          itemCount: direct.length,\n'
              '                          itemBuilder: (context, index) {\n'
              '                            final item = direct[index];\n'
              '                            return _ThreadTile(\n'
              '                              thread: item,\n'
              '                              selected:\n'
              '                                  selectedThread?.threadKey == item.threadKey,\n'
              '                              onTap: () => onSelectThread(item),\n'
              '                            );\n'
              '                          },\n'
              '                        ),\n'
              '                ),\n'
              '                if (assistant.isNotEmpty) ...[\n'
              '                  Divider(height: 1, color: scheme.outlineVariant),\n'
              '                  Padding(\n'
              '                    padding: const EdgeInsets.all(8),\n'
              '                    child: _ThreadTile(\n'
              '                      thread: assistant.first,\n'
              '                      selected:\n'
              '                          selectedThread?.threadKey ==\n'
              '                          assistant.first.threadKey,\n'
              '                      onTap: () => onSelectThread(assistant.first),\n'
              '                      assistant: true,\n'
              '                      locked: _aiAssistantLocked,\n'
              '                    ),\n'
              '                  ),\n'
              '                ],\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        );\n'
              '      },\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ThreadTile extends StatelessWidget {\n'
              '  final CompanyChatThread thread;\n'
              '  final bool selected;\n'
              '  final VoidCallback onTap;\n'
              '  final bool assistant;\n'
              '  final bool locked;\n'
              '\n'
              '  const _ThreadTile({\n'
              '    required this.thread,\n'
              '    required this.selected,\n'
              '    required this.onTap,\n'
              '    this.assistant = false,\n'
              '    this.locked = false,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final scheme = Theme.of(context).colorScheme;\n'
              '    final subtitle = locked\n'
              '        ? \'Временно недоступен\'\n'
              '        : thread.lastMessagePreview.isNotEmpty\n'
              '        ? thread.lastMessagePreview\n'
              '        : thread.isDirect\n'
              '        ? AppUserProfile.titleForRole(thread.role)\n'
              '        : thread.isAssistant\n'
              '        ? \'Подключён к AppСтрой\'\n'
              '        : \'Для всей компании\';\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),\n'
              '      child: Material(\n'
              '        color: selected\n'
              '            ? (assistant ? scheme.tertiaryContainer : scheme.primaryContainer)\n'
              '            : Colors.transparent,\n'
              '        borderRadius: BorderRadius.circular(13),\n'
              '        child: InkWell(\n'
              '          borderRadius: BorderRadius.circular(13),\n'
              '          onTap: onTap,\n'
              '          child: Padding(\n'
              '            padding: const EdgeInsets.symmetric(horizontal: 9, vertical: 8),\n'
              '            child: Row(\n'
              '              children: [\n'
