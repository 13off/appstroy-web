              '                          color: _detailMuted,\n'
              '                        ),\n'
              '                        SizedBox(width: 7),\n'
              '                        Expanded(\n'
              '                          child: Text(\n'
              '                            message.isStoredAttachment\n'
              '                                ? attachmentTitle\n'
              '                                : \'Вложение обрабатывается\',\n'
              '                            maxLines: 2,\n'
              '                            overflow: TextOverflow.ellipsis,\n'
              '                            style: TextStyle(\n'
              '                              color: _detailText,\n'
              '                              fontSize: 12,\n'
              '                              fontWeight: FontWeight.w800,\n'
              '                            ),\n'
              '                          ),\n'
              '                        ),\n'
              '                      ],\n'
              '                    ),\n'
              '                    SizedBox(height: 7),\n'
              '                    Row(\n'
              '                      children: [\n'
              '                        Expanded(\n'
              '                          child: TextButton.icon(\n'
              '                            onPressed:\n'
              '                                message.isStoredAttachment && openingId == null\n'
              '                                ? () => openStoredFile(\n'
              '                                    id: message.id,\n'
              '                                    bucket: message.storageBucket,\n'
              '                                    path: message.storagePath,\n'
              '                                    title: attachmentTitle,\n'
              '                                    isImage: message.mimeType.startsWith(\n'
              '                                      \'image/\',\n'
              '                                    ),\n'
              '                                  )\n'
              '                                : null,\n'
              '                            icon: Icon(Icons.visibility_outlined, size: 18),\n'
              '                            label: const Text(\'Открыть\'),\n'
              '                          ),\n'
              '                        ),\n'
              '                        Expanded(\n'
              '                          child: TextButton.icon(\n'
              '                            onPressed:\n'
              '                                message.isStoredAttachment && !downloading\n'
              '                                ? () => downloadMessageAttachment(message)\n'
              '                                : null,\n'
              '                            icon: downloading\n'
              '                                ? SizedBox(\n'
              '                                    width: 16,\n'
              '                                    height: 16,\n'
              '                                    child: CircularProgressIndicator(\n'
              '                                      strokeWidth: 2,\n'
              '                                    ),\n'
              '                                  )\n'
              '                                : Icon(Icons.download_rounded, size: 18),\n'
              '                            label: const Text(\'Скачать\'),\n'
              '                          ),\n'
              '                        ),\n'
              '                      ],\n'
              '                    ),\n'
              '                  ],\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '            SizedBox(height: 4),\n'
              '            Align(\n'
              '              alignment: Alignment.centerRight,\n'
              '              child: Text(\n'
              '                \'${inbound ? \'Кандидат\' : \'HR\'} · ${formatDate(message.createdAt)}\',\n'
              '                style: TextStyle(\n'
              '                  color: _detailMuted,\n'
              '                  fontSize: 10,\n'
              '                  fontWeight: FontWeight.w600,\n'
              '                ),\n'
              '              ),\n'
              '            ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget conversationSection() {\n'
              '    return Container(\n'
              '      height: 470,\n'
              '      clipBehavior: Clip.antiAlias,\n'
              '      decoration: BoxDecoration(\n'
              '        color: AppAdaptivePalette.surfaceSoft,\n'
              '        borderRadius: BorderRadius.circular(22),\n'
              '        border: Border.all(color: _detailBorder),\n'
              '      ),\n'
              '      child: Column(\n'
              '        children: [\n'
              '          Expanded(\n'
              '            child: FutureBuilder<List<RecruitmentMessage>>(\n'
              '              future: messagesFuture,\n'
              '              builder: (context, snapshot) {\n'
              '                if (snapshot.connectionState == ConnectionState.waiting &&\n'
              '                    !snapshot.hasData) {\n'
              '                  return const Center(child: CircularProgressIndicator());\n'
              '                }\n'
              '                if (snapshot.hasError) {\n'
              '                  return Center(\n'
              '                    child: Padding(\n'
              '                      padding: const EdgeInsets.all(18),\n'
              '                      child: _DetailMessage(\n'
              '                        icon: Icons.error_outline_rounded,\n'
              '                        text:\n'
              '                            \'Не удалось загрузить переписку: ${snapshot.error}\',\n'
              '                      ),\n'
              '                    ),\n'
              '                  );\n'
              '                }\n'
              '                final messages = snapshot.data ?? const <RecruitmentMessage>[];\n'
              '                if (messages.length != renderedMessageCount) {\n'
              '                  final animate = renderedMessageCount >= 0;\n'
              '                  renderedMessageCount = messages.length;\n'
              '                  scrollMessagesToBottom(animate: animate);\n'
              '                }\n'
              '                if (messages.isEmpty) {\n'
              '                  return const Center(\n'
              '                    child: Padding(\n'
              '                      padding: EdgeInsets.all(18),\n'
              '                      child: _DetailMessage(\n'
              '                        icon: Icons.forum_outlined,\n'
              '                        text: \'Переписка пока не начата.\',\n'
              '                      ),\n'
              '                    ),\n'
              '                  );\n'
              '                }\n'
              '                return Scrollbar(\n'
              '                  controller: messageScrollController,\n'
              '                  thumbVisibility: true,\n'
              '                  child: ListView.builder(\n'
              '                    controller: messageScrollController,\n'
              '                    reverse: false,\n'
