              '                child: Column(\n'
              '                  crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '                  children: [\n'
              '                    Row(\n'
              '                      children: [\n'
              '                        Icon(\n'
              '                          message.mimeType.startsWith(\'image/\')\n'
              '                              ? Icons.image_outlined\n'
