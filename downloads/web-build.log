              '      });\n'
              '    if (stored.isEmpty) {\n'
              '      showError(\'У кандидата пока нет загруженных документов\');\n'
              '      return;\n'
              '    }\n'
              '\n'
              '    setState(() => downloadingArchive = true);\n'
              '    try {\n'
              '      final archive = Archive();\n'
              '      final pdfImages = <Uint8List>[];\n'
              '      for (final document in stored) {\n'
              '        final bytes = await RecruitmentRepository.downloadStoredFile(\n'
              '          bucket: document.storageBucket,\n'
              '          path: document.storagePath,\n'
              '        );\n'
              '        archive.addFile(\n'
              '          ArchiveFile(downloadName(document), bytes.length, bytes),\n'
              '        );\n'
              '        if (document.isImage) pdfImages.add(bytes);\n'
              '      }\n'
              '\n'
              '      final candidate = safeFilePart(widget.application.fullName);\n'
              '      final suffix = candidate.isEmpty ? \'Кандидат\' : candidate;\n'
              '      if (pdfImages.isNotEmpty) {\n'
              '        final pdf = pw.Document(\n'
              '          title: \'Документы ${widget.application.fullName}\',\n'
              '          author: \'AppСтрой\',\n'
              '        );\n'
              '        for (final bytes in pdfImages) {\n'
              '          final image = pw.MemoryImage(bytes);\n'
              '          pdf.addPage(\n'
              '            pw.Page(\n'
              '              pageFormat: PdfPageFormat.a4,\n'
              '              margin: const pw.EdgeInsets.all(24),\n'
              '              build: (_) =>\n'
              '                  pw.Center(child: pw.Image(image, fit: pw.BoxFit.contain)),\n'
              '            ),\n'
              '          );\n'
              '        }\n'
              '        final pdfBytes = await pdf.save();\n'
              '        archive.addFile(\n'
              '          ArchiveFile(\'Документы_$suffix.pdf\', pdfBytes.length, pdfBytes),\n'
              '        );\n'
              '      }\n'
              '\n'
              '      final encoded = ZipEncoder().encode(archive);\n'
              '      if (encoded == null || encoded.isEmpty) {\n'
              '        throw Exception(\'Не удалось собрать ZIP\');\n'
              '      }\n'
              '      await FileSaver.instance.saveFile(\n'
              '        name: \'Документы_$suffix\',\n'
              '        bytes: Uint8List.fromList(encoded),\n'
              '        ext: \'zip\',\n'
              '        mimeType: MimeType.zip,\n'
              '      );\n'
              '    } catch (error) {\n'
              '      showError(\'Не удалось скачать архив: $error\');\n'
              '    } finally {\n'
              '      if (mounted) setState(() => downloadingArchive = false);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  Future<void> sendMessage() async {\n'
              '    final text = messageController.text.trim();\n'
              '    if (sending || text.isEmpty) return;\n'
              '    setState(() => sending = true);\n'
              '    try {\n'
              '      await RecruitmentRepository.sendCandidateMessage(\n'
              '        applicationId: widget.application.id,\n'
              '        message: text,\n'
              '        source: widget.application.source,\n'
              '      );\n'
              '      messageController.clear();\n'
              '      if (mounted) {\n'
              '        ScaffoldMessenger.of(context).showSnackBar(\n'
              '          const SnackBar(content: Text(\'Сообщение отправлено кандидату\')),\n'
              '        );\n'
              '      }\n'
              '      await refresh();\n'
              '    } catch (error) {\n'
              '      showError(\'Не удалось отправить сообщение: $error\');\n'
              '    } finally {\n'
              '      if (mounted) setState(() => sending = false);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  String formatDate(DateTime value) {\n'
              '    final local = value.toLocal();\n'
              '    final day = local.day.toString().padLeft(2, \'0\');\n'
              '    final month = local.month.toString().padLeft(2, \'0\');\n'
              '    final hour = local.hour.toString().padLeft(2, \'0\');\n'
              '    final minute = local.minute.toString().padLeft(2, \'0\');\n'
              '    return \'$day.$month.${local.year} · $hour:$minute\';\n'
              '  }\n'
              '\n'
              '  String formatBytes(int? bytes) {\n'
              '    if (bytes == null || bytes <= 0) return \'\';\n'
              '    if (bytes < 1024) return \'$bytes Б\';\n'
              '    final kb = bytes / 1024;\n'
              '    if (kb < 1024) return \'${kb.toStringAsFixed(0)} КБ\';\n'
              '    return \'${(kb / 1024).toStringAsFixed(1)} МБ\';\n'
              '  }\n'
              '\n'
              '  Widget sectionTitle(String title, {Widget? trailing}) {\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(bottom: 10),\n'
              '      child: Row(\n'
              '        children: [\n'
              '          Expanded(\n'
              '            child: Text(\n'
              '              title,\n'
              '              style: TextStyle(\n'
              '                color: _detailText,\n'
              '                fontSize: 19,\n'
              '                fontWeight: FontWeight.w900,\n'
              '              ),\n'
              '            ),\n'
              '          ),\n'
              '          if (trailing != null) trailing,\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget infoRow(IconData icon, String label, String value) {\n'
              '    if (value.trim().isEmpty) return const SizedBox.shrink();\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(bottom: 10),\n'
              '      child: Row(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: [\n'
              '          Icon(icon, size: 20, color: _detailMuted),\n'
              '          SizedBox(width: 10),\n'
              '          Expanded(\n'
              '            child: Column(\n'
              '              crossAxisAlignment: CrossAxisAlignment.start,\n'
              '              children: [\n'
              '                Text(\n'
              '                  label,\n'
              '                  style: TextStyle(\n'
              '                    color: _detailMuted,\n'
              '                    fontSize: 12,\n'
              '                    fontWeight: FontWeight.w700,\n'
              '                  ),\n'
              '                ),\n'
              '                SizedBox(height: 2),\n'
              '                Text(\n'
              '                  value,\n'
              '                  style: TextStyle(\n'
              '                    color: _detailText,\n'
              '                    fontWeight: FontWeight.w800,\n'
              '                  ),\n'
              '                ),\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget summaryCard() {\n'
              '    final application = widget.application;\n'
              '    final stage = widget.configuration.stageForApplication(application);\n'
              '    final customFields = widget.configuration.fields\n'
              '        .map(\n'
              '          (field) => MapEntry(\n'
              '            field,\n'
              '            field.formatValue(application.customValue(field.id)),\n'
              '          ),\n'
              '        )\n'
              '        .where((entry) => entry.value.isNotEmpty)\n'
              '        .toList();\n'
              '    return PremiumWorkCard(\n'
              '      radius: 24,\n'
              '      padding: const EdgeInsets.all(17),\n'
              '      child: Column(\n'
              '        crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '        children: [\n'
              '          Wrap(\n'
              '            spacing: 8,\n'
              '            runSpacing: 8,\n'
              '            children: [\n'
              '              _DetailPill(\n'
              '                icon: Icons.flag_outlined,\n'
              '                label: stage?.title ?? application.statusTitle,\n'
              '              ),\n'
              '              _DetailPill(\n'
              '                icon: Icons.send_outlined,\n'
              '                label: application.sourceTitle,\n'
              '              ),\n'
              '              if (application.citizenship.isNotEmpty)\n'
              '                _DetailPill(\n'
              '                  icon: Icons.public_outlined,\n'
              '                  label: application.citizenship,\n'
              '                ),\n'
              '            ],\n'
              '          ),\n'
              '          SizedBox(height: 16),\n'
              '          infoRow(Icons.work_outline_rounded, \'Вакансия\', application.vacancy),\n'
              '          infoRow(Icons.apartment_outlined, \'Объект\', application.objectName),\n'
              '          infoRow(Icons.badge_outlined, \'Опыт\', application.experience),\n'
              '          if (application.comment.isNotEmpty)\n'
              '            infoRow(Icons.notes_rounded, \'Комментарий HR\', application.comment),\n'
              '          ...customFields.map(\n'
              '            (entry) =>\n'
              '                infoRow(Icons.tune_rounded, entry.key.title, entry.value),\n'
              '          ),\n'
              '          SizedBox(height: 4),\n'
              '          Row(\n'
              '            children: [\n'
              '              Expanded(\n'
              '                child: OutlinedButton.icon(\n'
              '                  onPressed: application.phone.isEmpty ? null : callCandidate,\n'
              '                  icon: Icon(Icons.phone_outlined),\n'
              '                  label: const Text(\'Позвонить\'),\n'
              '                ),\n'
              '              ),\n'
              '              SizedBox(width: 10),\n'
              '              Expanded(\n'
              '                child: OutlinedButton.icon(\n'
              '                  onPressed: application.phone.isEmpty ? null : copyPhone,\n'
              '                  icon: Icon(Icons.copy_rounded),\n'
              '                  label: const Text(\'Копировать номер\'),\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget documentCard(RecruitmentDocument document) {\n'
              '    final waiting = !document.isStored;\n'
              '    final downloading = downloadingIds.contains(document.id);\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(bottom: 12),\n'
              '      child: Container(\n'
              '        clipBehavior: Clip.antiAlias,\n'
              '        decoration: BoxDecoration(\n'
              '          color: _detailSurface,\n'
              '          borderRadius: BorderRadius.circular(22),\n'
              '          border: Border.all(color: _detailBorder),\n'
              '        ),\n'
              '        child: Column(\n'
              '          crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '          children: [\n'
              '            Padding(\n'
              '              padding: const EdgeInsets.all(14),\n'
              '              child: Column(\n'
              '                crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '                children: [\n'
              '                  Row(\n'
              '                    children: [\n'
              '                      Container(\n'
              '                        width: 44,\n'
              '                        height: 44,\n'
              '                        decoration: BoxDecoration(\n'
              '                          color: waiting\n'
              '                              ? _detailWarning.withValues(alpha: 0.14)\n'
              '                              : _detailSuccess.withValues(alpha: 0.14),\n'
              '                          borderRadius: BorderRadius.circular(15),\n'
              '                        ),\n'
              '                        child: Icon(\n'
              '                          document.mimeType == \'application/pdf\'\n'
              '                              ? Icons.picture_as_pdf_outlined\n'
              '                              : Icons.image_outlined,\n'
              '                          color: waiting ? _detailWarning : _detailSuccess,\n'
              '                        ),\n'
              '                      ),\n'
              '                      SizedBox(width: 12),\n'
              '                      Expanded(\n'
              '                        child: Column(\n'
              '                          crossAxisAlignment: CrossAxisAlignment.start,\n'
              '                          children: [\n'
              '                            Text(\n'
              '                              document.title,\n'
              '                              style: TextStyle(\n'
              '                                color: _detailText,\n'
              '                                fontWeight: FontWeight.w900,\n'
              '                              ),\n'
              '                            ),\n'
              '                            SizedBox(height: 3),\n'
              '                            Text(\n'
              '                              waiting\n'
              '                                  ? \'Файл обрабатывается\'\n'
              '                                  : <String>[\n'
              '                                      downloadName(document),\n'
              '                                      if (formatBytes(\n'
              '                                        document.sizeBytes,\n'
              '                                      ).isNotEmpty)\n'
              '                                        formatBytes(document.sizeBytes),\n'
              '                                    ].join(\' · \'),\n'
              '                              style: TextStyle(\n'
              '                                color: _detailMuted,\n'
              '                                fontSize: 12,\n'
              '                                fontWeight: FontWeight.w600,\n'
              '                              ),\n'
              '                            ),\n'
              '                          ],\n'
              '                        ),\n'
              '                      ),\n'
              '                    ],\n'
              '                  ),\n'
              '                  SizedBox(height: 12),\n'
              '                  Row(\n'
              '                    children: [\n'
              '                      Expanded(\n'
              '                        child: OutlinedButton.icon(\n'
              '                          onPressed: waiting || openingId != null\n'
              '                              ? null\n'
              '                              : () => openStoredFile(\n'
              '                                  id: document.id,\n'
              '                                  bucket: document.storageBucket,\n'
              '                                  path: document.storagePath,\n'
              '                                  title: downloadName(document),\n'
              '                                  isImage: document.isImage,\n'
              '                                ),\n'
              '                          icon: Icon(Icons.open_in_new_rounded),\n'
              '                          label: const Text(\'Открыть\'),\n'
              '                        ),\n'
              '                      ),\n'
              '                      SizedBox(width: 10),\n'
              '                      Expanded(\n'
              '                        child: FilledButton.tonalIcon(\n'
              '                          onPressed: waiting || downloading\n'
              '                              ? null\n'
              '                              : () => downloadDocument(document),\n'
              '                          icon: downloading\n'
              '                              ? SizedBox(\n'
              '                                  width: 17,\n'
              '                                  height: 17,\n'
              '                                  child: CircularProgressIndicator(\n'
              '                                    strokeWidth: 2,\n'
              '                                  ),\n'
              '                                )\n'
              '                              : Icon(Icons.download_rounded),\n'
              '                          label: const Text(\'Скачать\'),\n'
              '                        ),\n'
              '                      ),\n'
              '                    ],\n'
              '                  ),\n'
              '                ],\n'
              '              ),\n'
              '            ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget documentsSection() {\n'
              '    return FutureBuilder<List<RecruitmentDocument>>(\n'
              '      future: documentsFuture,\n'
              '      builder: (context, snapshot) {\n'
              '        if (snapshot.connectionState == ConnectionState.waiting &&\n'
              '            !snapshot.hasData) {\n'
              '          return const Center(child: CircularProgressIndicator());\n'
              '        }\n'
              '        if (snapshot.hasError) {\n'
              '          return _DetailMessage(\n'
              '            icon: Icons.error_outline_rounded,\n'
              '            text: \'Не удалось загрузить документы: ${snapshot.error}\',\n'
              '          );\n'
              '        }\n'
              '        final documents = snapshot.data ?? const <RecruitmentDocument>[];\n'
              '        if (documents.isEmpty) {\n'
              '          return const _DetailMessage(\n'
              '            icon: Icons.folder_open_outlined,\n'
              '            text: \'Кандидат пока не прислал документы.\',\n'
              '          );\n'
              '        }\n'
              '        final storedCount = documents.where((item) => item.isStored).length;\n'
              '        return Column(\n'
              '          crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '          children: [\n'
              '            if (storedCount > 0) ...[\n'
              '              SizedBox(\n'
              '                height: 50,\n'
              '                child: FilledButton.tonalIcon(\n'
              '                  onPressed: downloadingArchive\n'
              '                      ? null\n'
              '                      : () => downloadAllDocuments(documents),\n'
              '                  icon: downloadingArchive\n'
              '                      ? SizedBox(\n'
              '                          width: 18,\n'
              '                          height: 18,\n'
              '                          child: CircularProgressIndicator(strokeWidth: 2),\n'
              '                        )\n'
              '                      : Icon(Icons.folder_zip_outlined),\n'
              '                  label: Text(\n'
              '                    downloadingArchive\n'
              '                        ? \'Собираем архив...\'\n'
              '                        : \'Скачать все ZIP · $storedCount\',\n'
              '                  ),\n'
              '                ),\n'
              '              ),\n'
              '              SizedBox(height: 12),\n'
              '            ],\n'
              '            ...documents.map(documentCard),\n'
              '          ],\n'
              '        );\n'
              '      },\n'
              '    );\n'
              '  }\n'
              '\n'
