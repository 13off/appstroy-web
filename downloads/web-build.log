              '      alignment: inbound ? Alignment.centerLeft : Alignment.centerRight,\n'
              '      child: Container(\n'
              '        constraints: const BoxConstraints(maxWidth: 500),\n'
              '        margin: const EdgeInsets.only(bottom: 8),\n'
              '        padding: const EdgeInsets.fromLTRB(12, 9, 12, 7),\n'
              '        decoration: BoxDecoration(\n'
              '          color: inbound ? _detailSurface : AppAdaptivePalette.selectedSurface,\n'
              '          borderRadius: BorderRadius.only(\n'
              '            topLeft: const Radius.circular(17),\n'
              '            topRight: const Radius.circular(17),\n'
              '            bottomLeft: Radius.circular(inbound ? 5 : 17),\n'
              '            bottomRight: Radius.circular(inbound ? 17 : 5),\n'
